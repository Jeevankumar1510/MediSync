# ==========================================
# MediSync AI - Environment Configuration
# ==========================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="MediSync AI"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL + pgvector)
POSTGRES_USER=medisync_user
POSTGRES_PASSWORD=medisync_password
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=medisync_db

# Async URL for FastAPI (asyncpg)
DATABASE_URL=postgresql+asyncpg://medisync_user:medisync_password@localhost:5432/medisync_db
# Sync URL for Celery and Alembic (psycopg2)
SYNC_DATABASE_URL=postgresql+psycopg2://medisync_user:medisync_password@localhost:5432/medisync_db

# Redis & Celery
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# JWT Authentication
SECRET_KEY=dev_insecure_secret_key_change_in_production_medi_sync_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Vector & RAG Configuration
# Default free local embedding model: sentence-transformers/all-MiniLM-L6-v2 (dim: 384)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# LLM Provider Configuration (Configurable: groq / ollama / gemini / openai)
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Encryption Key for API Integration Credentials (Fernet 32-byte urlsafe base64)
# Generated via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=gK7K-q_X1xMvP0R5K-q_X1xMvP0R5K-q_X1xMvP0R5E=

# CORS Settings (comma-separated origins)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

